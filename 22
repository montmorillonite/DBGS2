/* =========================================================
   Geometry SVG
========================================================= */

function updateGeometrySVG(B, H, theta) {

    /*
       Diagram is schematic, not exact scale.
    */

    const wallX = 575;

    const groundY = 205;

    const maxDisplayH = 140;

    const visualH =
        Math.min(
            120,
            Math.max(
                35,
                H * 45
            )
        );

    let run =
        visualH
        / Math.max(
            Math.tan(deg2rad(theta)),
            0.01
        );

    run =
        Math.min(
            470,
            Math.max(
                100,
                run
            )
        );

    const leftX =
        wallX - run;

    const topY =
        groundY - visualH;

    $("fillPolygon").setAttribute(
        "points",
        `${leftX},${groundY}
         ${leftX},${topY}
         ${wallX},${topY}
         ${wallX},${groundY}`
    );

    $("pileLine").setAttribute(
        "x1",
        wallX
    );

    $("pileLine").setAttribute(
        "x2",
        wallX
    );

    $("pileLine").setAttribute(
        "y1",
        topY - 15
    );

    $("pileLine").setAttribute(
        "y2",
        240
    );

    $("svgB").setAttribute(
        "x",
        (leftX + wallX) / 2 - 20
    );

    $("svgB").setAttribute(
        "y",
        topY - 10
    );

    $("svgB").textContent =
        `B = ${B.toFixed(2)} m`;

    $("svgH").setAttribute(
        "x",
        wallX + 20
    );

    $("svgH").setAttribute(
        "y",
        (topY + groundY) / 2
    );

    $("svgH").textContent =
        `H = ${H.toFixed(2)} m`;

    $("svgTheta").setAttribute(
        "x",
        leftX + 10
    );

    $("svgTheta").setAttribute(
        "y",
        groundY - 10
    );

    $("svgTheta").textContent =
        `${theta.toFixed(1)}°`;
}


/* =========================================================
   Chart
========================================================= */

function drawChart(results) {

    const canvas =
        $("chart");

    const ctx =
        canvas.getContext("2d");

    const W =
        canvas.width;

    const H =
        canvas.height;

    ctx.clearRect(
        0, 0, W, H
    );

    const margin = {
        left: 65,
        right: 30,
        top: 25,
        bottom: 50
    };

    const plotW =
        W
        - margin.left
        - margin.right;

    const plotH =
        H
        - margin.top
        - margin.bottom;

    const finite =
        results.filter(
            r => Number.isFinite(r.D)
        );

    if (!finite.length) {

        ctx.font =
            "15px Arial";

        ctx.fillText(
            "계산 가능한 근입깊이가 없습니다.",
            80,
            100
        );

        return;
    }

    const xMin =
        Math.min(
            ...finite.map(r => r.S)
        );

    const xMax =
        Math.max(
            ...finite.map(r => r.S)
        );

    const yMax =
        Math.max(
            1,
            ...finite.map(r => r.D)
        ) * 1.15;


    function xScale(x) {

        if (xMax === xMin)
            return margin.left + plotW / 2;

        return margin.left
             + (x - xMin)
             / (xMax - xMin)
             * plotW;
    }


    function yScale(y) {

        return margin.top
             + plotH
             - y / yMax * plotH;
    }


    /*
       axes
    */

    ctx.strokeStyle = "#444";
    ctx.lineWidth = 1;

    ctx.beginPath();

    ctx.moveTo(
        margin.left,
        margin.top
    );

    ctx.lineTo(
        margin.left,
        margin.top + plotH
    );

    ctx.lineTo(
        margin.left + plotW,
        margin.top + plotH
    );

    ctx.stroke();


    /*
       y grid
    */

    ctx.font =
        "12px Arial";

    ctx.fillStyle =
        "#444";

    for (let i = 0; i <= 5; i++) {

        const y =
            yMax * i / 5;

        const py =
            yScale(y);

        ctx.strokeStyle =
            "#ddd";

        ctx.beginPath();

        ctx.moveTo(
            margin.left,
            py
        );

        ctx.lineTo(
            margin.left + plotW,
            py
        );

        ctx.stroke();

        ctx.fillStyle =
            "#444";

        ctx.fillText(
            y.toFixed(1),
            20,
            py + 4
        );
    }


    /*
       result line
    */

    ctx.strokeStyle =
        "#246c94";

    ctx.lineWidth =
        2;

    ctx.beginPath();

    finite.forEach(
        (r, i) => {

            const px =
                xScale(r.S);

            const py =
                yScale(r.D);

            if (i === 0)
                ctx.moveTo(px, py);
            else
                ctx.lineTo(px, py);
        }
    );

    ctx.stroke();


    /*
       points
    */

    finite.forEach(r => {

        const px =
            xScale(r.S);

        const py =
            yScale(r.D);

        ctx.beginPath();

        ctx.arc(
            px,
            py,
            5,
            0,
            Math.PI * 2
        );

        ctx.fillStyle =
            "#246c94";

        ctx.fill();

        ctx.fillStyle =
            "#222";

        ctx.fillText(
            `${r.S.toFixed(1)} m`,
            px - 15,
            margin.top + plotH + 22
        );

        ctx.fillText(
            r.D.toFixed(2),
            px - 12,
            py - 9
        );
    });


    ctx.font =
        "13px Arial";

    ctx.fillStyle =
        "#222";

    ctx.fillText(
        "H형강 간격 S (m)",
        W / 2 - 45,
        H - 8
    );

    ctx.save();

    ctx.translate(
        13,
        H / 2 + 35
    );

    ctx.rotate(
        -Math.PI / 2
    );

    ctx.fillText(
        "필요 근입깊이 D (m)",
        0,
        0
    );

    ctx.restore();
}


/* =========================================================
   Main calculation
========================================================= */

function calculate() {

    const {
        B,
        theta,
        H
    } = getGeometry();


    /*
       Height and boards
    */

    const boardHeight =
        Math.max(
            num("boardHeight"),
            0.01
        );

    const boards =
        Math.ceil(
            H / boardHeight
        );


    /*
       Rankine coefficients
    */

    const fillCoeff =
        rankine(
            num("phiFill")
        );

    let nativeKa;
    let nativeKp;

    if (
        $("nativeMode").value
        === "undrained"
    ) {
        nativeKa = 1;
        nativeKp = 1;
    }
    else {

        const coeff =
            rankine(
                num("phiNative")
            );

        nativeKa =
            coeff.Ka;

        nativeKp =
            coeff.Kp;
    }


    /*
       Section
    */

    const section =
        sectionProperties();


    /*
       Outputs
    */

    $("outH").textContent =
        H.toFixed(2) + " m";

    $("outBoards").textContent =
        boards + " 단";

    $("outKa").textContent =
        fillCoeff.Ka.toFixed(3);

    $("outKp").textContent =
        nativeKp.toFixed(3);


    $("outArea").textContent =
        section.A.toFixed(0)
        + " mm²";

    $("outIx").textContent =
        section.Ix.toExponential(3)
        + " mm⁴";

    $("outZx").textContent =
        section.Zx.toExponential(3)
        + " mm³";

    $("outMy").textContent =
        section.My.toFixed(1)
        + " kN·m";

    $("outMa").textContent =
        section.Ma.toFixed(1)
        + " kN·m";


    /*
       Soil info
    */

    if (
        $("nativeMode").value
        === "drained"
    ) {

        $("soilInfo").innerHTML =
            `
            <b>원지반 배수해석</b><br>
            γ = ${num("gammaNative").toFixed(1)} kN/m³,
            φ = ${num("phiNative").toFixed(1)}°,
            c = ${num("cNative").toFixed(1)} kPa<br>
            Ka = ${nativeKa.toFixed(3)},
            Kp = ${nativeKp.toFixed(3)}
            `;
    }
    else {

        $("soilInfo").innerHTML =
            `
            <b>원지반 비배수 φ=0 간이해석</b><br>
            γ = ${num("gammaNative").toFixed(1)} kN/m³,
            Su = ${num("Su").toFixed(1)} kPa<br>
            Ka = Kp = 1.0의 총응력 개념을 사용합니다.
            `;
    }


    /*
       Candidate spacings
    */

    const spacings =
        $("spacingList")
        .value
        .split(",")
        .map(v => parseFloat(v.trim()))
        .filter(v =>
            Number.isFinite(v)
            && v > 0
        )
        .sort((a,b) => a-b);


    const maxEmbed =
        num("maxEmbed");

    const kM =
        num("momentFactor");

    const results = [];


    spacings.forEach(S => {

        const D =
            solveEmbedment(
                H,
                S
            );

        const Mdrive =
            drivingMoment(
                H,
                S
            );

        /*
            Simplified structural screening moment
        */

        const Mcheck =
            Mdrive * kM;

        const utilization =
            section.Ma > 0
            ? Mcheck / section.Ma
            : Infinity;

        const Bp =
            passiveWidth(S);

        const totalLength =
            Number.isFinite(D)
            ? H + D
            : Infinity;

        const steelIndex =
            Number.isFinite(D)
            ? totalLength / S
            : Infinity;

        const ok =
            Number.isFinite(D)
            &&
            D <= maxEmbed
            &&
            utilization <= 1.0;

        results.push({

            S,
            Bp,
            D,
            Mdrive,
            Mcheck,
            utilization,
            totalLength,
            steelIndex,
            ok
        });
    });


    /*
       Select recommendation:
       minimum pile-length index among valid candidates
    */

    const valid =
        results
        .filter(r => r.ok)
        .sort(
            (a,b) =>
            a.steelIndex
            - b.steelIndex
        );

    const recommended =
        valid.length
        ? valid[0]
        : null;


    /*
       Table
    */

    const tbody =
        $("resultBody");

    tbody.innerHTML = "";

    results.forEach(r => {

        const tr =
            document.createElement(
                "tr"
            );

        if (
            recommended
            &&
            Math.abs(
                recommended.S - r.S
            ) < 1e-9
        ) {
            tr.classList.add(
                "recommended"
            );
        }

        const Dtext =
            Number.isFinite(r.D)
            ? r.D.toFixed(2)
            : "> 20";

        const Ltext =
            Number.isFinite(r.totalLength)
            ? r.totalLength.toFixed(2)
            : "-";

        const Itext =
            Number.isFinite(r.steelIndex)
            ? r.steelIndex.toFixed(2)
            : "-";

        const utilText =
            Number.isFinite(r.utilization)
            ? (r.utilization * 100)
                .toFixed(1) + "%"
            : "-";

        tr.innerHTML =
            `
            <td>${r.S.toFixed(2)}</td>
            <td>${r.Bp.toFixed(2)}</td>
            <td>${r.Mcheck.toFixed(1)}</td>
            <td>${Dtext}</td>
            <td>${Ltext}</td>
            <td>${utilText}</td>
            <td>${Itext}</td>
            <td class="${r.ok ? "ok" : "ng"}">
                ${r.ok ? "예비 OK" : "검토 필요"}
            </td>
            `;

        tbody.appendChild(tr);
    });


    /*
       Recommendation
    */

    if (recommended) {

        $("recommendation").innerHTML =
            `
            현재 입력조건에 대한 <b>예비 비교결과</b>입니다.<br><br>

            성토폭
            <b>B = ${B.toFixed(2)} m</b><br>

            성토높이
            <b>H = ${H.toFixed(2)} m</b><br>

            토류판
            <b>${boards}단</b>
            (${boardHeight.toFixed(2)} m/단 기준)<br><br>

            후보 중 H형강량 지수가 가장 작은 안:<br>

            <b>
            H-300×300×15×15 @
            ${recommended.S.toFixed(2)} m
            </b><br>

            필요 근입깊이:
            <b>${recommended.D.toFixed(2)} m</b><br>

            H형강 전체 길이:
            <b>${recommended.totalLength.toFixed(2)} m</b><br>

            예비 모멘트 이용률:
            <b>${(recommended.utilization * 100).toFixed(1)}%</b><br>

            H형강량 지수:
            <b>${recommended.steelIndex.toFixed(2)} m/m</b><br><br>

            ※ 이것은 후보안 상대비교 결과이며
            최종 설계값을 의미하지 않습니다.
            `;
    }
    else {

        $("recommendation").innerHTML =
            `
            현재 설정에서는 모든 후보 간격이
            허용 근입깊이 또는 H형강 예비 모멘트 조건을 벗어납니다.<br><br>

            다음 중 하나를 검토하십시오.<br>

            · H형강 간격 축소<br>
            · H형강 단면 증가<br>
            · 수동저항 조건 재검토<br>
            · 근입깊이 증가<br>
            · 성토높이 또는 상재하중 변경
            `;
    }


    updateGeometrySVG(
        B,
        H,
        theta
    );

    drawChart(
        results
    );
}


/* =========================================================
   Events
========================================================= */

document
.querySelectorAll(
    "input, select"
)
.forEach(el => {

    el.addEventListener(
        "input",
        calculate
    );

    el.addEventListener(
        "change",
        calculate
    );
});


$("nativeMode")
.addEventListener(
    "change",
    () => {

        updateModeVisibility();
        calculate();
    }
);


$("heightMode")
.addEventListener(
    "change",
    () => {

        const manual =
            $("heightMode").value
            === "manual";

        $("manualH").disabled =
            !manual;

        calculate();
    }
);


/* =========================================================
   Initial
========================================================= */

updateModeVisibility();
calculate();

</script>

