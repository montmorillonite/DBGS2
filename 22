<script>

/* =========================================================
   Basic utilities
========================================================= */

const $ = id => document.getElementById(id);

const gammaW = 9.81;

function num(id) {
    return parseFloat($(id).value) || 0;
}

function deg2rad(deg) {
    return deg * Math.PI / 180;
}

function clamp(value, min, max) {
    return Math.max(min, Math.min(max, value));
}


/* =========================================================
   Rankine coefficients
========================================================= */

function rankine(phiDeg) {

    const phi = deg2rad(phiDeg);

    const Ka =
        Math.pow(
            Math.tan(
                Math.PI / 4 - phi / 2
            ), 2
        );

    const Kp =
        Math.pow(
            Math.tan(
                Math.PI / 4 + phi / 2
            ), 2
        );

    return { Ka, Kp };
}


/* =========================================================
   Effective stress
   depth : m
   gamma : kN/m3
   zw    : groundwater depth below reference surface
========================================================= */

function effectiveVerticalStress(depth, gamma, zw) {

    if (depth <= 0) return 0;

    if (zw >= depth) {
        return gamma * depth;
    }

    const gammaSub = Math.max(gamma - gammaW, 0);

    return gamma * Math.max(zw, 0)
         + gammaSub * Math.max(depth - zw, 0);
}


function waterPressure(depth, zw) {

    if (depth <= zw) return 0;

    return gammaW * (depth - zw);
}


/* =========================================================
   Numerical integration - Simpson-like midpoint method
========================================================= */

function integrate(fn, a, b, n = 400) {

    if (b <= a) return 0;

    const dx = (b - a) / n;

    let sum = 0;

    for (let i = 0; i < n; i++) {

        const x = a + (i + 0.5) * dx;

        sum += fn(x) * dx;
    }

    return sum;
}


/* =========================================================
   Geometry
========================================================= */

function getGeometry() {

    const B = num("B");
    const theta = num("theta");

    let H;

    if ($("heightMode").value === "manual") {
        H = num("manualH");
    }
    else {
        H = B * Math.tan(deg2rad(theta));
    }

    return { B, theta, H };
}


/* =========================================================
   Fill-side active earth pressure
   z = depth from top of fill
========================================================= */

function fillPressure(z, H) {

    const gamma = num("gammaFill");
    const phi = num("phiFill");
    const c = num("cFill");
    const q = num("surcharge");
    const zw = num("gwFill");

    const { Ka } = rankine(phi);

    const sigmaEff =
        effectiveVerticalStress(z, gamma, zw);

    const cohesionTerm =
        2 * c * Math.sqrt(Ka);

    const soilPressure =
        Math.max(
            Ka * (q + sigmaEff) - cohesionTerm,
            0
        );

    const u = waterPressure(z, zw);

    return soilPressure + u;
}


/* =========================================================
   Native ground pressure
   y = depth below original ground level
========================================================= */

function nativePressures(y, H) {

    const mode = $("nativeMode").value;

    const gammaN = num("gammaNative");
    const gammaF = num("gammaFill");

    const q = num("surcharge");

    const zwN = num("gwNative");
    const zwF = num("gwFill");

    const etaP = num("etaPassive");

    /*
       Vertical overburden from fill at existing ground
    */

    if (mode === "undrained") {

        const Su = num("Su");

        /*
            Simplified phi = 0 total-stress approach.

            Active:
              sigma_h = sigma_v - 2Su

            Passive:
              sigma_h = sigma_v + 2Su
        */

        const sigmaFillBottom =
            gammaF * H;

        const sigmaBack =
            q
            + sigmaFillBottom
            + gammaN * y;

        const sigmaFront =
            gammaN * y;

        const pBack =
            Math.max(
                sigmaBack - 2 * Su,
                0
            );

        const pFront =
            etaP * Math.max(
                sigmaFront + 2 * Su,
                0
            );

        return {
            active: pBack,
            passive: pFront
        };
    }


    /*
        Drained c-phi approach
    */

    const phiN = num("phiNative");
    const cN = num("cNative");

    const { Ka, Kp } = rankine(phiN);

    const fillBottomEff =
        effectiveVerticalStress(
            H,
            gammaF,
            zwF
        );

    const nativeEff =
        effectiveVerticalStress(
            y,
            gammaN,
            zwN
        );

    /*
       Back-side active pressure below original ground
    */

    const sigmaBackEff =
        q
        + fillBottomEff
        + nativeEff;

    let pBackSoil =
        Ka * sigmaBackEff
        - 2 * cN * Math.sqrt(Ka);

    pBackSoil =
        Math.max(pBackSoil, 0);


    /*
       Hydrostatic pressure behind wall.

       Treat fill water depth as measured from top of fill.
    */

    const uBack =
        waterPressure(
            H + y,
            zwF
        );


    /*
       Front-side passive pressure
    */

    let pFrontSoil =
        Kp * nativeEff
        + 2 * cN * Math.sqrt(Kp);

    pFrontSoil =
        Math.max(pFrontSoil, 0);

    pFrontSoil *= etaP;

    const uFront =
        waterPressure(
            y,
            zwN
        );


    return {

        active:
            pBackSoil + uBack,

        passive:
            pFrontSoil + uFront
    };
}


/* =========================================================
   H section properties
   ignoring root fillets
========================================================= */

function sectionProperties() {

    const h = num("pileH");
    const b = num("pileB");
    const tw = num("tw");
    const tf = num("tf");

    const hw =
        h - 2 * tf;

    const A =
        2 * b * tf
        + hw * tw;

    const d =
        h / 2 - tf / 2;

    const IxFlange =
        b * Math.pow(tf, 3) / 12
        + b * tf * Math.pow(d, 2);

    const IxWeb =
        tw * Math.pow(hw, 3) / 12;

    const Ix =
        2 * IxFlange + IxWeb;

    const Zx =
        Ix / (h / 2);

    const Fy =
        num("Fy");

    /*
       Fy MPa = N/mm2
       Z mm3
       N.mm --> kN.m : / 1e6
    */

    const My =
        Fy * Zx / 1e6;

    const Ma =
        My * num("capacityFactor");

    return {
        A,
        Ix,
        Zx,
        My,
        Ma
    };
}


/* =========================================================
   Driving moment produced by retained fill

   Pressure is kN/m2
   spacing S is m

   line load = pressure * S = kN/m

   M about original ground:
       integral p(z)*S*(H-z) dz
========================================================= */

function drivingMoment(H, spacing) {

    return integrate(
        z =>
            fillPressure(z, H)
            * spacing
            * (H - z),
        0,
        H
    );
}


/* =========================================================
   Passive effective width

   Bp = min(spacing, kb * flange width)
========================================================= */

function passiveWidth(spacing) {

    const flangeWidth =
        num("pileB") / 1000;

    const kb =
        num("passiveWidthFactor");

    return Math.min(
        spacing,
        kb * flangeWidth
    );
}


/* =========================================================
   Resisting moment from embedded native soil
========================================================= */

function resistingMoment(D, H, spacing) {

    const Bp =
        passiveWidth(spacing);

    return integrate(

        y => {

            const p =
                nativePressures(y, H);

            /*
                Net resisting lateral pressure
            */

            const net =
                p.passive - p.active;

            /*
                Signed moment contribution
            */

            return net * Bp * y;
        },

        0,
        D
    );
}


/* =========================================================
   Solve required embedment depth

   Mres >= FS * Mdrive
========================================================= */

function solveEmbedment(H, spacing) {

    const FS =
        num("embedFS");

    const Mdrive =
        drivingMoment(H, spacing);

    const target =
        FS * Mdrive;

    let low = 0.05;
    let high = 0.50;

    const searchLimit = 20;

    /*
       Expand high until resistance exceeds target
    */

    while (
        resistingMoment(
            high,
            H,
            spacing
        ) < target
        &&
        high < searchLimit
    ) {
        high *= 1.35;
    }


    if (high >= searchLimit) {

        if (
            resistingMoment(
                searchLimit,
                H,
                spacing
            ) < target
        ) {
            return Infinity;
        }

        high = searchLimit;
    }


    /*
       Bisection
    */

    for (let i = 0; i < 60; i++) {

        const mid =
            (low + high) / 2;

        const Mr =
            resistingMoment(
                mid,
                H,
                spacing
            );

        if (Mr >= target)
            high = mid;
        else
            low = mid;
    }

    return high;
}


